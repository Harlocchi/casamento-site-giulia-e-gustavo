# Copie este arquivo para  server/.env  e preencha.
# O .env NÃO vai pro git (veja .gitignore).

# Chave SECRETA da AbacatePay (API v2) — painel > Integrações / API Keys.
# Usada pelo server.js (checkout PIX + cartão) e pelo npm run produtos:sync.
# Nunca coloque isto no index.html nem em qualquer arquivo do front.
ABACATEPAY_API_KEY=abc_dev_troque_pela_sua_chave

# (opcional) Chave v2 separada só para o script de produtos, se quiser.
# ABACATEPAY_API_KEY_V2=

# URL pública do site já no ar. O checkout redireciona o convidado de volta
# pra cá (completionUrl). Em dev, se vazio, usa a origin da requisição.
# Também faz o produtos:sync usar fotos/<id>.jpg como imagem dos produtos.
# SITE_URL=https://seu-app.fly.dev

# Segredo do webhook — você inventa uma string aleatória grande e usa a mesma
# na URL cadastrada no painel: .../api/webhook/abacatepay?webhookSecret=ESSE_VALOR
ABACATEPAY_WEBHOOK_SECRET=troque_por_uma_string_aleatoria_bem_grande

# 1 = ambiente de testes: o webhook aceita eventos sem assinatura HMAC
# (pra simulações do painel). Use 0 em produção.
ABACATEPAY_DEV=1

# Token de admin — protege POST/GET /api/guests e GET /api/presentes.
ADMIN_TOKEN=outra_string_aleatoria

# Porta do servidor.
PORT=3000

# ---- Banco de dados (PostgreSQL) ----
# String de conexão. Neon / Supabase / Render / Railway te dão essa URL pronta.
#   postgres://usuario:senha@host:5432/nome_do_banco
DATABASE_URL=postgres://postgres:postgres@localhost:5432/casamento

# SSL: "auto" (padrão) liga SSL, exceto quando o host é localhost.
# Force com "require" (bancos gerenciados) ou "disable" (Postgres local sem TLS).
# DATABASE_SSL=auto

# (opcional) tamanho do pool de conexões. Padrão: 10
# PGPOOL_MAX=10
